<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>College Student Dashboard</title>

    <link rel="stylesheet" href="style.css">
</head>

<body>

    <!-- Header -->
    <header>
        <h1>Student Dashboard</h1>
        <p>Welcome to Your College Portal</p>
    </header>

    <!-- Navigation -->
    <nav>
        <a href="#profile">Profile</a>
        <a href="#attendance">Attendance</a>
        <a href="#marks">Marks</a>
        <a href="#timetable">Timetable</a>
        <a href="#announcements">Announcements</a>
    </nav>

    <!-- Main Content -->
    <main>

        <!-- Student Profile -->
        <section id="profile" class="card">
            <h2>Student Profile</h2>

            <p><strong>Name:</strong> Roop</p>
            <p><strong>Roll Number:</strong> 101</p>
            <p><strong>Course:</strong> B.Tech CSE</p>
            <p><strong>Semester:</strong> 1st Semester</p>
        </section>

        <!-- Attendance -->
        <section id="attendance" class="card">
            <h2>Attendance</h2>

            <p>Overall Attendance: 85%</p>

            <div class="progress">
                <div class="progress-bar attendance-bar">
                    85%
                </div>
            </div>
        </section>

        <!-- Marks -->
        <section id="marks" class="card">
            <h2>Marks</h2>

            <table>
                <tr>
                    <th>Subject</th>
                    <th>Marks</th>
                </tr>

                <tr>
                    <td>Mathematics</td>
                    <td>85</td>
                </tr>

                <tr>
                    <td>Physics</td>
                    <td>90</td>
                </tr>

                <tr>
                    <td>Programming</td>
                    <td>95</td>
                </tr>
            </table>
        </section>

        <!-- Subjects -->
        <section class="card">
            <h2>My Subjects</h2>

            <ul>
                <li>Mathematics</li>
                <li>Physics</li>
                <li>Programming in C</li>
                <li>Web Development</li>
                <li>English</li>
            </ul>
        </section>

        <!-- Timetable -->
        <section id="timetable" class="card">
            <h2>Class Timetable</h2>

            <table>
                <tr>
                    <th>Time</th>
                    <th>Subject</th>
                </tr>

                <tr>
                    <td>9:00 - 10:00</td>
                    <td>Mathematics</td>
                </tr>

                <tr>
                    <td>10:00 - 11:00</td>
                    <td>Physics</td>
                </tr>

                <tr>
                    <td>11:00 - 12:00</td>
                    <td>Programming</td>
                </tr>

                <tr>
                    <td>1:00 - 2:00</td>
                    <td>Web Development</td>
                </tr>
            </table>
        </section>

        <!-- Notifications -->
        <section class="card">
            <h2>Notifications</h2>

            <ul>
                <li>Assignment submission is due tomorrow.</li>
                <li>Internal examinations start next week.</li>
                <li>Library books must be returned on time.</li>
            </ul>
        </section>

        <!-- Announcements -->
        <section id="announcements" class="card">
            <h2>College Announcements</h2>

            <p>College will remain closed on Sunday.</p>

            <p>All students must attend the upcoming seminar.</p>

            <p>Sports day registrations are now open.</p>
        </section>

    </main>

    <!-- Footer -->
    <footer>
        <p>&copy; 2026 College Student Dashboard</p>
    </footer>

</body>
</html>
