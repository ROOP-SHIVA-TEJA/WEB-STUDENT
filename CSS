/* General Styling */
* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}

body {
    font-family: Arial, sans-serif;
    background-color: #f1f5f9;
    color: #333;
    line-height: 1.6;
}

/* Header */
header {
    background-color: #1e3a8a;
    color: white;
    text-align: center;
    padding: 25px;
}

header h1 {
    font-size: 30px;
    margin-bottom: 5px;
}

/* Navigation */
nav {
    background-color: #2563eb;
    text-align: center;
    padding: 12px;
}

nav a {
    color: white;
    text-decoration: none;
    margin: 0 15px;
    font-weight: bold;
}

nav a:hover {
    color: #facc15;
}

/* Main Content */
main {
    width: 90%;
    max-width: 1100px;
    margin: 25px auto;

    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 20px;
}

/* Dashboard Cards */
.card {
    background-color: white;
    padding: 20px;
    border-radius: 10px;

    box-shadow: 0 3px 10px rgba(0, 0, 0, 0.1);
}

.card h2 {
    color: #1e3a8a;
    margin-bottom: 15px;
    border-bottom: 2px solid #2563eb;
    padding-bottom: 8px;
}

/* Student Profile */
#profile p {
    margin: 8px 0;
}

/* Attendance Progress Bar */
.progress {
    background-color: #e5e7eb;
    height: 25px;
    border-radius: 20px;
    overflow: hidden;
    margin-top: 10px;
}

.progress-bar {
    height: 100%;
    background-color: #16a34a;
    color: white;
    text-align: center;
    font-weight: bold;
}

.attendance-bar {
    width: 85%;
}

/* Tables */
table {
    width: 100%;
    border-collapse: collapse;
}

th {
    background-color: #2563eb;
    color: white;
}

th, td {
    border: 1px solid #ddd;
    padding: 10px;
    text-align: left;
}

tr:nth-child(even) {
    background-color: #f1f5f9;
}

/* Lists */
ul {
    padding-left: 20px;
}

li {
    margin-bottom: 8px;
}

/* Footer */
footer {
    background-color: #1e3a8a;
    color: white;
    text-align: center;
    padding: 15px;
    margin-top: 30px;
}

/* Responsive Design */
@media (max-width: 768px) {

    main {
        grid-template-columns: 1fr;
    }

    nav a {
        display: inline-block;
        margin: 5px;
    }

    header h1 {
        font-size: 24px;
    }
}
